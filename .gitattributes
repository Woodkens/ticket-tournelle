# Fins de ligne Unix (LF) dans le dépôt, quel que soit le poste (Windows ou Debian).
# Sans cela, Windows ajoute des CR qui cassent les scripts shell et la config Nginx.
* text=auto eol=lf

# Scripts Windows : CRLF obligatoire
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Fichiers binaires : jamais modifiés
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.woff binary
*.woff2 binary
