{% extends 'base.html.twig' %}

{% block title %}{{ 'forgot.title'|trans }} · {{ parent() }}{% endblock %}

{% block body %}
    <div class="tt-carte mx-auto bg-white p-4">
        <h1 class="h4">{{ 'forgot.sent_title'|trans }}</h1>
        {# Même texte que le compte existe ou non : la page ne confirme jamais l'existence d'un compte #}
        <p>{{ 'forgot.sent_text'|trans }}</p>
        <p class="small text-secondary">{{ 'forgot.sent_hint'|trans }}</p>
        <a class="btn btn-primary w-100" href="{{ path('app_login') }}">{{ 'forgot.back'|trans }}</a>
    </div>
{% endblock %}
