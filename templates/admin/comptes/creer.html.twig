{% extends 'admin/_layout.html.twig' %}

{% block title %}{{ 'admin.create.title'|trans }} · {{ parent() }}{% endblock %}

{% block body %}
    <div class="tt-carte tt-carte-large mx-auto bg-white p-4">
        <h1 class="h4 mb-1">{{ 'admin.create.title'|trans }}</h1>
        {# Pas de champ « mot de passe » : le titulaire le choisit lui-même avec le lien reçu par e-mail #}
        <p class="text-secondary mb-4">{{ 'admin.create.subtitle'|trans }}</p>

        {{ form_start(formulaire) }}
            {{ form_widget(formulaire) }}
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">{{ 'admin.create.submit'|trans }}</button>
                <a class="btn btn-outline-secondary" href="{{ path('app_admin_comptes') }}">{{ 'admin.cancel'|trans }}</a>
            </div>
        {{ form_end(formulaire) }}
    </div>
{% endblock %}
