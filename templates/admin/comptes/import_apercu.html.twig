{% extends 'admin/_layout.html.twig' %}

{% block title %}{{ 'import.preview.title'|trans }} · {{ parent() }}{% endblock %}

{% block body %}
    <h1 class="h3">{{ 'import.preview.title'|trans }}</h1>

    {# Rien n'a encore été écrit en base : cette page ne fait que montrer le résultat de la vérification #}
    {% if rapport.erreurFichier %}
        <div class="alert alert-danger" role="alert">{{ rapport.erreurFichier.cle|trans(rapport.erreurFichier.params) }}</div>
    {% elseif rapport.estValide %}
        <div class="alert alert-success" role="status">{{ 'import.preview.ok'|trans({'%nombre%': rapport.lignes|length}) }}</div>
    {% else %}
        <div class="alert alert-danger" role="alert">
            {{ 'import.preview.errors'|trans({'%erreurs%': rapport.nombreDErreurs, '%nombre%': rapport.lignes|length}) }}
        </div>
    {% endif %}

    {% if rapport.lignes %}
        <div class="tt-panneau bg-white p-3">
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <caption class="visually-hidden">{{ 'import.preview.title'|trans }}</caption>
                    <thead>
                        <tr>
                            <th scope="col">{{ 'import.preview.line'|trans }}</th>
                            <th scope="col">{{ 'admin.accounts.col.name'|trans }}</th>
                            <th scope="col">{{ 'admin.accounts.col.email'|trans }}</th>
                            <th scope="col">{{ 'admin.accounts.col.role'|trans }}</th>
                            <th scope="col">{{ 'import.preview.result'|trans }}</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for ligne in rapport.lignes %}
                            <tr class="{{ ligne.estValide ? '' : 'table-danger' }}" data-ligne="{{ ligne.numero }}">
                                <td>{{ ligne.numero }}</td>
                                {# Données du fichier : échappées par Twig comme tout le reste, jamais de |raw #}
                                <td>{{ ligne.nom }} {{ ligne.prenom }}</td>
                                <td>{{ ligne.email }}</td>
                                <td>{{ ligne.role ? ('role.' ~ ligne.role.value)|trans : ligne.roleSaisi }}</td>
                                <td>
                                    {% if ligne.estValide %}
                                        <span class="badge text-bg-success">{{ 'import.preview.valid'|trans }}</span>
                                    {% else %}
                                        <ul class="mb-0 ps-3">
                                            {% for erreur in ligne.erreurs %}
                                                <li>{{ erreur.cle|trans(erreur.params) }}</li>
                                            {% endfor %}
                                        </ul>
                                    {% endif %}
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    {% endif %}

    <div class="d-flex gap-2 mt-3">
        {% if rapport.estValide %}
            <form method="post" action="{{ path('app_admin_import_confirmer') }}" class="m-0">
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('import-confirmer') }}">
                <button type="submit" class="btn btn-primary">{{ 'import.preview.confirm'|trans({'%nombre%': rapport.lignes|length}) }}</button>
            </form>
        {% endif %}
        <a class="btn btn-outline-secondary" href="{{ path('app_admin_import') }}">{{ 'import.preview.other_file'|trans }}</a>
    </div>
{% endblock %}
