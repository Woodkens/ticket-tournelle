{# E-mail d'activation ou de réinitialisation. Aucune image ni ressource externe ; tout le texte vient de translations/. #}
<!DOCTYPE html>
<html lang="{{ app.locale }}">
    <body style="font-family: Arial, Helvetica, sans-serif; color: #1f2937; line-height: 1.5;">
        <p>{{ 'email.common.hello'|trans({'%prenom%': prenom}) }}</p>
        <p>{{ (cle ~ '.intro')|trans }}</p>
        <p>
            <a href="{{ lien }}" style="display: inline-block; padding: 10px 18px; background: #1d4ed8; color: #ffffff; text-decoration: none; border-radius: 6px;">
                {{- (cle ~ '.button')|trans -}}
            </a>
        </p>
        <p>{{ 'email.common.copy_link'|trans }}<br>{{ lien }}</p>
        <p>{{ 'email.common.expires'|trans({'%date%': expiration|date('d/m/Y H:i')}) }}</p>
        <p style="color: #6b7280; font-size: 13px;">{{ (cle ~ '.ignore')|trans }}</p>
        <p style="color: #6b7280; font-size: 13px;">{{ 'footer.text'|trans }}</p>
    </body>
</html>
